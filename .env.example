# ============================================================================
# BUGZ BrightUpGenZ - Environment Variables Template (.env.example)
# ============================================================================
# QUY TẮC AN TOÀN & PHÂN CHẶNG (Xem chi tiết tại ENV_SETUP.md):
# - Chặng P00 KHÔNG yêu cầu cấu hình các biến ngoại vi bên dưới để build và hiển thị khung ứng dụng.
# - KHÔNG điền giá trị giả để vượt kiểm tra.
# - KHÔNG đặt Firebase Admin credential, MQTT credential hoặc SMTP password/API key vào biến VITE_*.
# - Chỉ yêu cầu cấu hình khi triển khai/chạy tính năng của chặng liên quan (P01, P03, P04).

# ----------------------------------------------------------------------------
# 0. Biến Môi trường Nền tảng AI Studio
# ----------------------------------------------------------------------------
APP_URL="https://ais-dev-cpvxdfw7ppcnylrbqrv7t6-716862869640.asia-southeast1.run.app"

# ----------------------------------------------------------------------------
# 1. Chặng P01: Firebase Authentication & Realtime Database (Tạm thời chưa sử dụng)
# ----------------------------------------------------------------------------
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_DATABASE_URL=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""

# ----------------------------------------------------------------------------
# 2. Firebase Admin SDK Phía Server (Tạm thời chưa sử dụng)
# ----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=""
# FIREBASE_DATABASE_URL=""
# FIREBASE_STORAGE_BUCKET=""
SUPERADMIN_BOOTSTRAP_EMAIL="minhquantran4312@gmail.com,tamtranmusic@gmail.com"

# Tùy chọn khi cần chạy Firebase Admin SDK thật ở Backend (Có thể để trống khi dùng Emulator Sandbox P01/P02):
# Lấy tại: Project Settings -> Service accounts -> Generate new private key (dán JSON 1 dòng hoặc Base64)
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=""

# ----------------------------------------------------------------------------
# 2.1. Nhật ký phiên học phía Server (MongoDB Atlas)
# Chỉ MONGODB_URI là bắt buộc. Không đặt URI vào biến VITE_* hoặc commit URI thật.
# ----------------------------------------------------------------------------
# MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority"
# MONGODB_DB_NAME="bugz"
# MONGODB_STUDY_LOG_COLLECTION="study_session_logs"

# Tài khoản quản trị cố định (không lưu DB). Đây là giá trị mặc định trong code.
ADMIN_LOGIN_USERNAME="admin"
ADMIN_LOGIN_PASSWORD="123456"
# Khuyên đặt chuỗi ngẫu nhiên dài khi publish để chữ ký phiên ổn định và khó giả mạo.
# ADMIN_SESSION_SECRET=""

# ----------------------------------------------------------------------------
# 3. Chặng P03: MQTT Broker (TLS + ACL) & Robot Bridge (Adapter chuẩn: webhook_https)
# Giá trị hợp lệ của MQTT_ADAPTER_MODE: "webhook_https" | "node_worker"
# Lưu ý: Simulator trong môi trường Demo đi qua cùng luồng POST /api/ingest/mqtt với nhãn source="simulator"
# ----------------------------------------------------------------------------
# MQTT_ADAPTER_MODE="webhook_https"
# MQTT_BROKER_URL="mqtts://broker.example.com:8883"
# MQTT_WEBHOOK_SHARED_SECRET=""
# MQTT_PUBLISH_API_URL="https://broker.example.com/api/v5/publish"
# MQTT_PUBLISH_API_TOKEN=""
# MQTT_BRIDGE_USERNAME=""
# MQTT_BRIDGE_PASSWORD=""
# ROBOT_CLOCK_MAX_SKEW_MS="300000"
# CAPTURE_UPLOAD_TICKET_TTL_SEC="300"
# CAPTURE_RETENTION_DAYS="7"

# ----------------------------------------------------------------------------
# 4. Chặng P04: FCM Web Push & Email (Chỉ cần mở comment và điền khi sang Chặng P04)
# Giá trị hợp lệ của EMAIL_PROVIDER: "smtp" | "resend" | "sendgrid"
# ----------------------------------------------------------------------------
# VITE_FIREBASE_VAPID_KEY=""
# EMAIL_PROVIDER="smtp"
# SMTP_PORT="587"
# EMAIL_FROM_ADDRESS=""
# SMTP_HOST=""
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_API_KEY=""
